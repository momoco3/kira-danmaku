    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource/dela-gothic-one": "^5.3.0",
    "mp4-muxer": "^5.2.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.85.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.1"
  }
}
