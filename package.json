{
  "name": "kira-danmaku",
  "private": true,
  "version": "0.1.0",
  "description": "Make a sparkly illustration barrage (danmaku) video for streams. Transparent WebM or green-screen MP4, right in your browser.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build:live": "vite build --config vite.live.config.ts",
    "dev": "npm run build:live && vite",
